set counts [dict create]
foreach cell [get_cells -hier -filter {IS_PRIMITIVE}] {dict incr counts [get_property REF_NAME $cell]}
foreach ref [lsort [dict keys $counts]] {puts $f "$ref	[dict get $counts $ref]"}
close $f
foreach {ref expected} {DSP48E1 516 PCIE_2_1 1 GTXE2_CHANNEL 8} {
 if {![dict exists $counts $ref] || [dict get $counts $ref]!=$expected} {error "Wrong required primitive census: $ref"}
}
set bscan_cells [get_cells -hier -filter {REF_NAME == BSCANE2}]
if {[llength $bscan_cells]!=2} {error "Expected two retained BSCAN chains"}
set bscan_chain_ids [lsort -integer [get_property JTAG_CHAIN $bscan_cells]]
if {$bscan_chain_ids ne {2 3}} {error "Expected BSCAN chain IDs 2 and 3"}
set kernels [get_cells -hier -filter {ORIG_REF_NAME == rk_cmac_fp16_cell_dsp_prefix_pipe || REF_NAME == rk_cmac_fp16_cell_dsp_prefix_pipe}]
if {[llength $kernels]!=16} {error "Expected sixteen C32 kernels"}
set dsps [get_cells -hier -filter {REF_NAME == DSP48E1}]
set products 0
foreach kernel $kernels {
 set prefix "[get_property NAME $kernel]/"
 set owned 0
 foreach dsp $dsps {if {[string first $prefix [get_property NAME $dsp]]==0} {incr owned}}
 if {$owned!=32} {error "Kernel lost parallel product DSPs"}
 incr products $owned
}
if {$products!=512 || [llength $dsps]!=516} {error "Full512 product/auxiliary DSP mismatch"}
if {[llength [get_ports]]!=277} {error "Original242 plus35 PCIe scalar ports not retained"}
set mig_controllers [get_cells -hier -filter {ORIG_REF_NAME == mig_7series_v4_2_memc_ui_top_axi || REF_NAME == mig_7series_v4_2_memc_ui_top_axi || REF_NAME == mig_7series_v4_2_memc_ui_top_axi__parameterized0}]
if {[llength $mig_controllers]!=2} {error "Expected exactly two retained MIG memory-controller channels"}
set mig_c0 0
set mig_c1 0
foreach controller $mig_controllers {
 set name [get_property NAME $controller]
 if {[string match */c0_u_memc_ui_top_axi $name]} {incr mig_c0}
 if {[string match */c1_u_memc_ui_top_axi $name]} {incr mig_c1}
}
if {$mig_c0!=1 || $mig_c1!=1} {error "Expected one retained C0 and one retained C1 MIG controller"}
