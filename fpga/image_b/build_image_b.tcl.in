# Rendered by tools/merged/vivado_merged_image.py --profile image-b from
# fpga/image_b/image_b_sources.json.
#
# Standalone IMAGE B build (pooling corpus + EW FP16/FDIV + ew-int + USER2
# transport; Lead D1/D4 two-image split). No hardware connection, automatic FPGA programming
# or flash writing occurs. The timing/DRC/route/CDC/page-presence gates are the
# same gates the adopted images use; the reviewed emission block mirrors
# fpga/host/emit.tcl.in (pins/standards, route boolean checks, no waivers,
# reviewed DRC inventory, source-derived USR_ACCESS).
set root @ROOT@
set out @OUT@
set source_sha @SOURCE_SHA@
set source_tag @SOURCE_TAG@
set page_mask @PAGE_MASK@
set required_pages {@PAGE_LIST@}

# ---- source binding: the rendered package must be frozen and named by the
# ---- caller, exactly like the EW image's RK_HOST_PREPARED_SHA gate. ----------
if {![regexp {^[0-9a-f]{64}$} $source_sha]} { error "Invalid rendered source sha256." }
if {![regexp {^[0-9a-f]{8}$} $source_tag]} { error "Invalid rendered source tag." }
if {![regexp {^[01]{7}$} $page_mask]} { error "PAGE_MASK must be a 7-bit binary string." }
if {![info exists ::env(RK_MERGED_SOURCE_SHA)] || $::env(RK_MERGED_SOURCE_SHA) ne $source_sha} {
    error "Prepare a fresh package and export RK_MERGED_SOURCE_SHA equal to its source manifest sha256."
}
# ---- fresh output directory (never mix receipts from an earlier build) ------
if {[file exists $out] && [llength [glob -nocomplain -directory $out *]] != 0} {
    error "Merged image build requires a fresh output directory."
}
file mkdir $out
# ---- board facts are supplied explicitly, never defaulted -------------------
set emit_bitstream 0
if {[info exists ::env(RK_EMIT_BITSTREAM)]} { set emit_bitstream $::env(RK_EMIT_BITSTREAM) }
if {$emit_bitstream ni {0 1}} { error "RK_EMIT_BITSTREAM must be 0 or 1." }
if {![info exists ::env(RK_CONFIRM_BOARD)] || $::env(RK_CONFIRM_BOARD) ne "YPCB_00338_1P1"} {
    error "Set RK_CONFIRM_BOARD=YPCB_00338_1P1 only after checking the XDC against your board."
}
set emit_polarity 0
if {[info exists ::env(RK_LED_ACTIVE_LOW)]} {
    if {$::env(RK_LED_ACTIVE_LOW) ni {0 1}} { error "RK_LED_ACTIVE_LOW must be 0 or 1." }
    set emit_polarity $::env(RK_LED_ACTIVE_LOW)
} elseif {$emit_bitstream} {
    error "Set RK_LED_ACTIVE_LOW=0|1 after observing the board's LEDs; it is unverified in the donor sources."
}
set have_voltage [info exists ::env(RK_CONFIG_VOLTAGE)]
set have_cfgbvs [info exists ::env(RK_CFGBVS)]
if {$emit_bitstream || $have_voltage || $have_cfgbvs} {
    if {!$have_voltage || !$have_cfgbvs} {
        error "Supply both board-verified RK_CONFIG_VOLTAGE and RK_CFGBVS; see docs/FPGA.md."
    }
    if {$::env(RK_CONFIG_VOLTAGE) ni {1.5 1.8 2.5 3.3}} { error "Invalid RK_CONFIG_VOLTAGE." }
    if {$::env(RK_CFGBVS) ni {GND VCCO}} { error "RK_CFGBVS must be GND or VCCO." }
    if {($::env(RK_CONFIG_VOLTAGE) in {1.5 1.8} && $::env(RK_CFGBVS) ne "GND") ||
        ($::env(RK_CONFIG_VOLTAGE) in {2.5 3.3} && $::env(RK_CFGBVS) ne "VCCO")} {
        error "Incompatible RK_CONFIG_VOLTAGE/RK_CFGBVS pair; verify the actual board supplies and strap."
    }
}

# ---- synthesis -------------------------------------------------------------
create_project -in_memory -part @PART@
set_property include_dirs [list @INCLUDE_DIRS@] [current_fileset]
# Image B has no runtime conv engine, so it keeps the adopted images' define set
# (DESIGNWARE_NOEXIST) without SYNTHESIS. The EW/ew-int endpoints are added at
# S4/S5 with their own evidenced source lists.
set_property verilog_define {DESIGNWARE_NOEXIST} [current_fileset]
@READ_SOURCES@
read_xdc @CONSTRAINTS@
synth_design -top @TOP@ -part @PART@ -generic LED_ACTIVE_LOW=$emit_polarity -generic PAGE_MASK=7'b$page_mask
# The reviewed USER2 mailbox CDC constraints are applied unchanged. They bind
# u_mailbox/u_bscan by hierarchy name, so those names must not be renamed.
source @CDC@
rk_host_cdc_constrain
if {$have_voltage} {
    set_property CONFIG_VOLTAGE $::env(RK_CONFIG_VOLTAGE) [current_design]
    set_property CFGBVS $::env(RK_CFGBVS) [current_design]
}

# ---- unchanged clock / memory gates ---------------------------------------
set clocks [get_clocks -quiet sys_clk]
if {[llength $clocks] != 1} { error "Expected exactly one sys_clk constraint." }
set clock_period [get_property PERIOD [lindex $clocks 0]]
if {![string is double -strict $clock_period] || [catch {expr {double($clock_period) == 20.0}} expected_clock] || !$expected_clock} {
    error "Expected the unchanged 20.000 ns sys_clk constraint."
}
set brams [get_cells -hierarchical -filter {REF_NAME == RAMB18E1 || REF_NAME == RAMB36E1}]
if {[llength $brams] == 0} { error "No block RAM inferred for the shared memory aperture." }

# ---- page-presence gate ---------------------------------------------------
# Rendered from fpga/merged/merged_sources.json "required_pages" + per-page
# REF_NAME, so a placeholder stub cannot satisfy a real page slot once the real
# page is required. The list is the S1 minimum; S2 adds gemm_page.
@PAGE_GATES@
set bscan [get_cells -hierarchical -filter {REF_NAME == BSCANE2}]
if {[llength $bscan] != 1} { error "Expected exactly one USER2 BSCANE2 primitive." }
if {[get_property JTAG_CHAIN [lindex $bscan 0]] != 2} { error "Expected JTAG_CHAIN=2." }
write_checkpoint -force [file join $out post_synth.dcp]
report_utilization -file [file join $out utilization_synth.rpt]

# ---- implementation -------------------------------------------------------
opt_design
place_design
phys_opt_design
route_design
write_checkpoint -force [file join $out routed.dcp]
report_utilization -file [file join $out utilization.rpt]
report_route_status -file [file join $out route_status.rpt]
report_timing_summary -delay_type min_max -report_unconstrained -file [file join $out timing.rpt]
report_pulse_width -file [file join $out pulse_width.rpt]
check_timing -verbose -file [file join $out check_timing.rpt]
report_drc -file [file join $out drc.rpt]
rk_host_cdc_audit $out

# ---- timing / constraint gates (identical to the adopted image templates) --
foreach check {no_clock unconstrained_internal_endpoints} {
    set detail [check_timing -override_defaults $check -no_header -return_string]
    set channel [open [file join $out check_timing_${check}.rpt] w]
    puts $channel $detail
    close $channel
    set heading [format {(?im)^\s*(?:[0-9]+\.\s*)?checking\s+%s(?:\s*\([0-9]+\))?\.?\s*$} $check]
    if {![regexp $heading $detail]} {
        error "Unrecognized $check timing report; no bitstream is emitted."
    }
    set summaries 0
    foreach line [split $detail \n] {
        if {[regexp {^\s*There are ([0-9]+) .+} $line -> count]} {
            incr summaries
            if {$count != 0} { error "Unresolved $check timing findings ($count); no bitstream is emitted." }
        } elseif {[regexp -nocase {there are} $line]} {
            error "Unrecognized $check timing count; no bitstream is emitted."
        }
    }
    if {$summaries == 0} { error "Missing $check timing count; no bitstream is emitted." }
}
# Worst-slack gate. Two earlier versions were wrong:
#  1. reading SLACK off `get_timing_paths -max_paths 1` gives the generic pin
#     slack, not the path slack (it reported -90 ns for a design that failed at
#     -92 ns for a different reason, and +152 ns output for a design that was
#     actually clean only on jtag_tck);
#  2. taking the first numeric row anywhere in the report can pick a different
#     clock domain (the report carries jtag_tck AND sys_clk tables).
# This version anchors on the "Design Timing Summary" section and reads its data
# row. Row layout:
#   [0] WNS  [1] TNS  [2] TNS failing  [3] TNS total
#   [4] WHS  [5] THS  [6] THS failing  [7] THS total   [8] WPWS ...
foreach pair {{max 0} {min 4}} {
    lassign $pair delay_type column
    set report [report_timing_summary -delay_type $delay_type -max_paths 1 -no_header -return_string]
    set slack ""
    set in_section 0
    set seen_rule 0
    foreach line [split $report \n] {
        if {[regexp {Design Timing Summary} $line]} { set in_section 1; continue }
        if {!$in_section} { continue }
        if {[regexp {^\s*-----} $line]} { set seen_rule 1; continue }
        if {$seen_rule} {
            set numbers [regexp -all -inline {(-?[0-9]+(?:\.[0-9]+)?)} $line]
            if {[llength $numbers] >= 8} {
                set slack [lindex $numbers $column]
                break
            }
        }
    }
    if {![string is double -strict $slack]} {
        error "Could not read the $delay_type worst slack from the Design Timing Summary; no bitstream is emitted."
    }
    if {[expr {double($slack)}] < 0} {
        error "Negative $delay_type slack ($slack ns): no bitstream is emitted."
    }
    puts "timing gate: $delay_type worst slack $slack ns"
}
foreach violation [get_drc_violations] {
    set severity [string toupper [get_property SEVERITY $violation]]
    if {$severity ni {WARNING ADVISORY INFO}} {
        error "Blocking DRC violation $violation (severity $severity)."
    }
}
puts "Routed merged-image checkpoint/reports produced. Review timing, DRC, BRAM inference, page presence and CDC audit."

# ---- reviewed emission (same gate family as fpga/host/emit.tcl.in) ---------
if {$emit_bitstream} {
    if {[llength [get_waivers]] != 0} { error "Waivers are forbidden for an emitted image." }
    if {[report_route_status -boolean_check ROUTED_FULLY] != 1 ||
        [report_route_status -boolean_check ERRORS_IN_ROUTES] != 0} {
        error "Routing is not clean; no bitstream is emitted."
    }
    set expected_ports {SYS_CLK led_3bits_tri_o[0] led_3bits_tri_o[1] led_3bits_tri_o[2]}
    if {[lsort [get_ports]] ne [lsort $expected_ports]} { error "Wrong physical ports for the pinned image." }
    foreach {name pin direction} {SYS_CLK AA28 IN {led_3bits_tri_o[0]} P30 OUT {led_3bits_tri_o[1]} M30 OUT {led_3bits_tri_o[2]} N30 OUT} {
        set ports [get_ports -quiet [list $name]]
        if {[llength $ports] != 1} { error "Expected one exact physical port: $name" }
        set port [lindex $ports 0]
        if {[get_property PACKAGE_PIN $port] ne $pin ||
            [get_property DIRECTION $port] ne $direction ||
            [get_property IOSTANDARD $port] ne "LVCMOS18"} {
            error "Changed pin/standard/direction for $name."
        }
    }
    if {[get_property CONFIG_VOLTAGE [current_design]] != 1.8 ||
        [get_property CFGBVS [current_design]] ne "GND"} {
        error "Changed configuration-bank pair; emission requires the reviewed 1.8/GND values."
    }
    # Source identity metadata only; no datapath, placement or timing change.
    set_property BITSTREAM.CONFIG.USR_ACCESS 0x$source_tag [current_design]
    report_drc -ruledecks bitstream_checks -file [file join $out bitstream_drc.rpt]
    foreach violation [get_drc_violations] {
        set severity [string toupper [get_property SEVERITY $violation]]
        if {$severity ni {WARNING ADVISORY INFO}} { error "Unreviewed bitstream DRC finding: $violation" }
    }
    write_bitstream -force [file join $out host-merged.bit]
    puts "Merged image bitstream written; NOT programmed. Candidate image, review pending."
} else {
    puts "RK_EMIT_BITSTREAM not set: stopped at routed checkpoint, no .bit generated."
}
