# Rendered by tools/ppu/vivado_pool_corpus.py (build-synth stage) from
# fpga/ppu/corpus_sources.json. Synth stage of the staged pooling-corpus image
# build: synthesis + constraint application + pre-implementation gates only, no
# implementation, no bitstream, no hardware. The implementation stage opens the
# written post_synth.dcp (build_pool_corpus_impl.tcl.in).
set root @ROOT@
set out @OUT@
if {![info exists ::env(RK_CONFIRM_BOARD)] || $::env(RK_CONFIRM_BOARD) ne "YPCB_00338_1P1"} {
    error "Set RK_CONFIRM_BOARD=YPCB_00338_1P1 only after checking the XDC against your board."
}
# LED polarity is a board fact the donor design records as UNVERIFIED; it is
# supplied explicitly by the staged build invocation and only affects the
# elaboration constant (no gate is weakened).
set emit_polarity 0
if {[info exists ::env(RK_LED_ACTIVE_LOW)]} {
    if {$::env(RK_LED_ACTIVE_LOW) ni {0 1}} { error "RK_LED_ACTIVE_LOW must be 0 or 1." }
    set emit_polarity $::env(RK_LED_ACTIVE_LOW)
}
file mkdir $out
create_project -in_memory -part @PART@
set_property include_dirs [list @INCLUDE_DIRS@] [current_fileset]
set_property verilog_define {DESIGNWARE_NOEXIST} [current_fileset]
@READ_SOURCES@
read_xdc @CONSTRAINTS@
# Build-tool thread setting only: it does not change synthesis/implementation
# results or the unchanged timing/DRC gates.
set_param general.maxThreads @MAX_THREADS@
synth_design -top @TOP@ -part @PART@ -generic LED_ACTIVE_LOW=$emit_polarity -generic N_PAGES=@N_PAGES@
if {[info exists ::env(RK_CONFIG_VOLTAGE)]} {
    set_property CONFIG_VOLTAGE $::env(RK_CONFIG_VOLTAGE) [current_design]
    set_property CFGBVS $::env(RK_CFGBVS) [current_design]
}
set clocks [get_clocks -quiet sys_clk]
if {[llength $clocks] != 1} { error "Expected exactly one sys_clk constraint." }
set clock_period [get_property PERIOD [lindex $clocks 0]]
if {![string is double -strict $clock_period] || [catch {expr {double($clock_period) == 20.0}} expected_clock] || !$expected_clock} {
    error "Expected the unchanged 20.000 ns sys_clk constraint."
}
set brams [get_cells -hierarchical -filter {REF_NAME == RAMB18E1 || REF_NAME == RAMB36E1}]
if {[llength $brams] == 0} { error "No block RAM inferred for the shared memory aperture." }
# Every corpus page must be present and kept as a named instance.
# Count the page *instances* by their module type. Filtering on the instance
# NAME pattern (*g_pages*pool_page*) matches every descendant cell of each page
# (a few thousand per page), so its length can never equal the expected page
# count; the type filter is the structurally correct presence check.
# Vivado uniquifies parameterised instances during synthesis (the 19 pages
# elaborate as rk_ppu_pool_corpus_axi, rk_ppu_pool_corpus_axi_0, ...), so an
# exact REF_NAME comparison matches only one cell. Match the module-name prefix
# and require the page instance path so an unrelated cell cannot satisfy it.
set page_cells [get_cells -hierarchical -filter "NAME =~ *g_pages*pool_page* && REF_NAME =~ rk_ppu_pool_corpus_axi*"]
if {[llength $page_cells] != @N_PAGES@} {
    error "Expected exactly @N_PAGES@ elaborated corpus pages, found [llength $page_cells]"
}
set bscan [get_cells -hierarchical -filter {REF_NAME == BSCANE2}]
if {[llength $bscan] != 1} { error "Expected exactly one USER2 BSCANE2 primitive." }
if {[get_property JTAG_CHAIN [lindex $bscan 0]] != 2} { error "Expected JTAG_CHAIN=2." }
# Apply the reviewed USER2 mailbox CDC constraints on the synthesized design;
# the implementation stage re-applies them after opening the checkpoint.
source @CDC@
rk_host_cdc_constrain
write_checkpoint -force [file join $out post_synth.dcp]
report_utilization -file [file join $out utilization_synth.rpt]
puts "SYNTH_STAGE_DONE post_synth=[file join $out post_synth.dcp]"
