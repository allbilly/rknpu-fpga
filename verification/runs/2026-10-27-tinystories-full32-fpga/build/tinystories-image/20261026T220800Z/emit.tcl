set dcp [encoding convertfrom utf-8 [binary format H* {2f686f6d652f6665646f72612f726b6e70752d667067612f6275696c642f74696e7973746f726965732d667067612d7072657061726174696f6e2f6475616c2d76312f696d706c656d656e746174696f6e2f726f757465642e646370}]]
set out [encoding convertfrom utf-8 [binary format H* {2f686f6d652f6665646f72612f726b6e70752d667067612f6275696c642f74696e7973746f726965732d696d6167652f3230323631303236543232303830305a2f656d697373696f6e}]]
proc require {condition message} {if {!$condition} {error $message}}
proc finite {value} {
    return [expr {[string is double -strict $value] &&
        ![catch {expr {abs(double($value)) < Inf}} result] && $result}]
}
proc verify_image_inputs {} {
    global expected_inputs
    dict for {path expected} $expected_inputs {
        require [file isfile $path] "Missing qualified image input"
        # GNU -z prevents filename escaping; its output is not a Tcl list.
        set raw [exec sha256sum -z -- $path]
        require [regexp {^([0-9a-f]{64})[ 	]} $raw -> actual] "Unrecognized SHA256 result"
        require [expr {$actual eq $expected}] "Changed qualified image input"
    }
}
verify_image_inputs
require [expr {![file exists $out]}] "Fresh bitstream directory required"
file mkdir $out
open_checkpoint $dcp
require [expr {[get_property PART [current_design]] eq "xc7k480tffg1156-2" &&
               [get_property TOP [current_design]] eq "ypcb_tinystories_top"}] "Wrong exact routed design"
require [expr {[get_property CONFIG_VOLTAGE [current_design]] == 1.8 &&
               [get_property CFGBVS [current_design]] eq "GND"}] "Changed configuration-bank pair"
require [expr {[llength [get_waivers]] == 0}] "Waivers are forbidden"
require [expr {[report_route_status -boolean_check ROUTED_FULLY] == 1 &&
               [report_route_status -boolean_check ERRORS_IN_ROUTES] == 0}] "Routing is not clean"
require [expr {[lsort [get_ports]] eq [lsort {SYS_CLK led_3bits_tri_o[0] led_3bits_tri_o[1] led_3bits_tri_o[2]}]}] "Wrong physical ports"
foreach {name pin direction} {SYS_CLK AA28 IN {led_3bits_tri_o[0]} P30 OUT {led_3bits_tri_o[1]} M30 OUT {led_3bits_tri_o[2]} N30 OUT} {
    set ports [get_ports -quiet [list $name]]
    require [expr {[llength $ports] == 1}] "Expected one exact physical port"
    set port [lindex $ports 0]
    require [expr {[get_property PACKAGE_PIN $port] eq $pin &&
                   [get_property DIRECTION $port] eq $direction &&
                   [get_property IOSTANDARD $port] eq "LVCMOS18"}] "Changed pin/standard/direction"
}
# This invokes read-only checks on existing constraints, never reapplies them.
source [encoding convertfrom utf-8 [binary format H* {2f686f6d652f6665646f72612f726b6e70752d667067612f6275696c642f74696e7973746f726965732d667067612d7072657061726174696f6e2f6475616c2d76312f736f757263652f667067612f686f73742f6d61696c626f785f6364632e74636c}]]
source [encoding convertfrom utf-8 [binary format H* {2f686f6d652f6665646f72612f726b6e70752d667067612f6275696c642f74696e7973746f726965732d667067612d7072657061726174696f6e2f6475616c2d76312f736f757263652f667067612f74696e7973746f726965732f636865636b732e74636c}]]
rk_host_cdc_audit $out
rk_dual_full512
rk_dual_registered_reset $out image
set clocks [get_clocks -quiet]
require [expr {[llength $clocks] == 2}] "Expected SYS and USER2 TCK clocks"
set clock [rk_host_one [get_clocks -quiet sys_clk] sys_clk]
require [expr {[get_property NAME $clock] eq "sys_clk" && [get_property PERIOD $clock] == 20.0 &&
               [get_property WAVEFORM $clock] eq "0.000 10.000"}] "Changed SYS clock"
foreach delay {max min} {
    set paths [get_timing_paths -delay_type $delay -max_paths 1]
    require [expr {[llength $paths] == 1}] "Missing routed timing path"
    set slack [get_property SLACK [lindex $paths 0]]
    require [expr {[finite $slack] && $slack >= 0}] "Negative/invalid routed slack"
}
foreach check {no_clock unconstrained_internal_endpoints} {
    set detail [check_timing -override_defaults $check -no_header -return_string]
    require [regexp "checking ${check} \\(0\\)" $detail] "Missing/nonzero internal timing check"
    set found 0
    foreach count [regexp -all -inline {There are [0-9]+} $detail] {
        require [expr {[lindex $count 2] == 0}] "Unconstrained internal path"
        incr found
    }
    require [expr {$found > 0}] "Missing internal timing coverage"
}
rk_dual_pulse_gate [report_pulse_width -return_string]
set dsps [get_cells -hierarchical -filter {REF_NAME == DSP48E1}]
set brams [get_cells -hierarchical -filter {REF_NAME == RAMB18E1 || REF_NAME == RAMB36E1}]
set bscan [get_cells -hierarchical -filter {REF_NAME == BSCANE2}]
require [expr {[llength $dsps] == 516 && [llength $brams] == 256 && [llength $bscan] == 1}] "Changed full512+EW/1MiB/mailbox target"
require [expr {[get_property JTAG_CHAIN [lindex $bscan 0]] == 2}] "Wrong USER chain"
set facts [open [file join $out startup_facts.tsv] w]
set startup [get_cells -hierarchical -filter {NAME =~ startup/* && REF_NAME == FDRE}]
require [expr {[llength $startup] == 65}] "Expected 64 stages plus registered release"
foreach cell $startup {
    require [expr {[get_property INIT $cell] eq "1'b0"}] "Nonzero/unknown startup INIT"
    puts $facts "CELL\t$cell\t[get_property REF_NAME $cell]\t[get_property INIT $cell]"
    foreach pin [get_pins -of_objects $cell] {
        set nets [get_nets -segments -of_objects $pin]
        puts $facts "PIN\t$pin\t$nets\t[get_pins -of_objects $nets -filter {DIRECTION == OUT}]"
    }
}
close $facts
# The inherited native reset audit checks the full reset cone. Also check the
# two actual configuration INIT values before allowing image emission.
foreach {pattern expected} {endpoint/cm_engine/child_release_reg* 1'b1 startup/rst_n_reg* 1'b0} {
    set cells [get_cells -quiet -hierarchical -filter "NAME =~ $pattern"]
    require [expr {[llength $cells] > 0}] "Missing reset INIT source"
    foreach cell $cells {
        require [expr {[get_property INIT $cell] eq $expected}] "Changed local/global reset INIT"
    }
}
set counts [dict create DPIP-1 0 DPOP-1 0 DPOP-2 0]
report_drc -ruledecks default -file [file join $out default_drc.rpt]
foreach violation [get_drc_violations] {
    set name [get_property NAME $violation]
    require [expr {[get_property SEVERITY $violation] eq "Warning" || [get_property SEVERITY $violation] eq "WARNING"}] "Blocking/unreviewed DRC severity"
    require [regexp {^(DPIP-1|DPOP-1|DPOP-2)#[0-9]+$} $name -> rule] "Unreviewed default DRC rule"
    dict incr counts $rule
}
require [expr {[dict get $counts DPIP-1] == 1032 && [dict get $counts DPOP-1] == 516 &&
               [dict get $counts DPOP-2] == 516}] "Changed reviewed DRC inventory"
# Source identity metadata only; no datapath, placement or timing modification.
set_property BITSTREAM.CONFIG.USR_ACCESS 0x1e01179c [current_design]
report_drc -ruledecks bitstream_checks -file [file join $out bitstream_drc.rpt]
foreach violation [get_drc_violations] {
    set name [get_property NAME $violation]
    require [expr {[string toupper [get_property SEVERITY $violation]] eq "WARNING" &&
                   [regexp {^(DPIP-1|DPOP-1|DPOP-2)#[0-9]+$} $name]}] "Unreviewed bitstream DRC finding"
}
verify_image_inputs
write_checkpoint [file join $out image.dcp]
write_bitstream [file join $out tinystories-full512-dual.bit]
verify_image_inputs
puts "PASS_SOURCE_REVIEWED_TINYSTORIES_FULL512_DUAL_BITSTREAM_EMISSION"
exit
