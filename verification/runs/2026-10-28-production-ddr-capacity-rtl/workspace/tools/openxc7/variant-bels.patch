diff --git a/xilinx/arch.h b/xilinx/arch.h
index 2f87ffb..49e949c 100644
--- a/xilinx/arch.h
+++ b/xilinx/arch.h
@@ -778,13 +778,26 @@ struct Arch : BaseCtx
     IdString getBelName(BelId bel) const
     {
         NPNR_ASSERT(bel != BelId());
-        int site = locInfo(bel).bel_data[bel.index].site;
+        const auto &info = locInfo(bel);
+        const auto &data = info.bel_data[bel.index];
+        int site = data.site;
+        std::string bel_name = IdString(data.name).str(this);
+        // The exporter retains multiple variants of e.g. ILOGIC sites. Their
+        // CE1USED/IFF/etc. BEL names can repeat within the same physical site.
+        // Keep the first (legacy lookup) spelling, qualify later variants so
+        // every enumerated BEL round-trips without changing the database.
+        for (int i = 0; i < bel.index; ++i) {
+            if (info.bel_data[i].site == site && info.bel_data[i].name == data.name) {
+                bel_name += "@" + std::to_string(data.site_variant);
+                break;
+            }
+        }
         if (site != -1) {
             return id(std::string(chip_info->tile_insts[bel.tile].site_insts[site].name.get()) + "/" +
-                      IdString(locInfo(bel).bel_data[bel.index].name).str(this));
+                      bel_name);
         } else {
             return id(std::string(chip_info->tile_insts[bel.tile].name.get()) + "/" +
-                      IdString(locInfo(bel).bel_data[bel.index].name).str(this));
+                      bel_name);
         }
     }
 
diff --git a/xilinx/bel_variant_name.h b/xilinx/bel_variant_name.h
new file mode 100644
--- /dev/null
+++ b/xilinx/bel_variant_name.h
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: ISC
+// Optional canonical qualifier for BELs sharing a name across site variants.
+#ifndef XILINX_BEL_VARIANT_NAME_H
+#define XILINX_BEL_VARIANT_NAME_H
+#include <cstdint>
+#include <limits>
+#include <string>
+
+// Preserve the old unsuffixed lookup. Malformed/overflowing explicit variants
+// fail, rather than falling back to whichever variant appears first.
+inline bool split_bel_variant_name(std::string &name, int &variant)
+{
+    variant = -1;
+    auto at = name.find('@');
+    if (at == std::string::npos)
+        return true;
+    if (at == 0 || at + 1 == name.size())
+        return false;
+    int value = 0;
+    for (size_t i = at + 1; i < name.size(); ++i) {
+        char digit = name[i];
+        if (digit < '0' || digit > '9')
+            return false;
+        if (value > (std::numeric_limits<int16_t>::max() - (digit - '0')) / 10)
+            return false;
+        value = value * 10 + (digit - '0');
+    }
+    name.resize(at);
+    variant = value;
+    return true;
+}
+#endif
